#!/usr/bin/env node
// `mc` — Mission Control CLI for AGENTS. Lets a running agent read & write the backlog over the
// local API (no direct DB/file access needed; the daemon does the writes). Lives outside any
// workspace repo so the per-workspace sandbox lets every agent reach it. Network → localhost only.
//
// Context comes from env injected by the session/job spawner:
//   MC_API             base API url (default http://localhost:7777/api)
//   MC_WORKSPACE       workspace id (default --workspace for ticket new)
//   MC_WORKSPACE_TOKEN this workspace's API credential (PER-24) — scopes every call below to it
//   MC_REPO            repo id (default --repo)
//   MC_TICKET          the ticket key this agent is working (for `mc done`, `mc note`)
import fs from "node:fs";
import path from "node:path";
import os from "node:os";
import { spawn, spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";
const API = process.env.MC_API || "http://localhost:7777/api";
const REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
// Sent on every call when present — the API 404s any request this token doesn't own the workspace
// of (see checkScope in api.ts). Absent for a bare/manual `mc` invocation outside a spawned session.
const WS_TOKEN_HEADERS = process.env.MC_WORKSPACE_TOKEN ? { "x-mc-workspace-token": process.env.MC_WORKSPACE_TOKEN } : {};
// A Lead's own credential (LEADS.md). Sent IN ADDITION to the workspace token, on the calls where the
// daemon must know WHICH Lead is calling rather than only which workspace: `mc session new` stamps the
// new terminal's `lead_id` from it, which is what makes that terminal the Lead's — its stops wake the
// Lead instead of Robert, and only that Lead may type into it. Never sent from a worker; only a Lead's
// env carries MC_LEAD_TOKEN.
const LEAD_HEADERS = process.env.MC_LEAD_TOKEN ? { "x-mc-lead": process.env.MC_LEAD_TOKEN } : {};

function parse(argv) {
  const pos = [], opt = {}, multi = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const k = a.slice(2); const v = argv[i + 1]?.startsWith("--") ? "true" : argv[++i];
      opt[k] = v ?? "true";
      // `multi` keeps EVERY value a flag was given, in order, so a repeatable flag (`--goal a
      // --goal b` queues two goals) works without changing what `opt` means for the ninety others.
      (multi[k] ||= []).push(v ?? "true");
    }
    else pos.push(a);
  }
  return { pos, opt, multi };
}
async function req(method, path, body, headers) {
  const r = await fetch(API + path, {
    method,
    headers: { ...(body ? { "content-type": "application/json" } : {}), ...WS_TOKEN_HEADERS, ...headers },
    body: body ? JSON.stringify(body) : undefined,
  });
  const text = await r.text();
  let json; try { json = JSON.parse(text); } catch { json = text; }
  if (!r.ok) throw new Error(typeof json === "object" && json?.error ? json.error : `${r.status} ${text}`);
  return json;
}
function readStdin() {
  return new Promise((resolve) => {
    if (process.stdin.isTTY) return resolve("");
    let d = ""; process.stdin.setEncoding("utf8");
    process.stdin.on("data", (c) => (d += c));
    process.stdin.on("end", () => resolve(d));
    setTimeout(() => resolve(d), 250); // don't hang if nothing piped
  });
}
async function findSkill(wsId, ref) {
  const all = await req("GET", "/workspaces/" + wsId + "/skills");
  const s = all.find((x) => x.slug === ref || x.id === ref || x.id.startsWith(ref) || x.name?.toLowerCase() === String(ref).toLowerCase());
  if (!s) throw new Error(`skill not found: ${ref}`);
  return s;
}
async function findByKey(key) {
  const all = await req("GET", "/tickets");
  const t = all.find((x) => x.key?.toLowerCase() === String(key).toLowerCase() || x.id === key);
  if (!t) throw new Error(`ticket not found: ${key}`);
  return t;
}
const die = (m) => { console.error("mc: " + m); process.exit(1); };
// Piggyback printing: `mc step`/`mc note` (and `mc inbox`) responses carry any undelivered operator
// mailbox messages (see src/messages.ts) — surface them loudly so the worker actually reads them.
function printMessages(msgs) {
  if (!msgs || !msgs.length) return;
  console.log("📨 MESSAGE FROM OPERATOR — incorporate before continuing:");
  for (const m of msgs) console.log(`  [${m.from_who}] ${m.text}`);
}

// How each directed link type reads from the perspective of the ticket you're looking at.
const LINK_LABEL = {
  blocks: { out: "blocks", in: "blocked by" },
  parent: { out: "parent of", in: "child of" },
  relates: { out: "relates to", in: "relates to" },
  duplicates: { out: "duplicates", in: "duplicated by" },
};

// Admin token from ~/chronos/.admin-token (same as `mc ws create`). Global notes cross client walls,
// so promoting one is admin-gated → only runnable on the daemon host where the token is readable.
// The installed copy lives at ~/.mc/bin/mc, so REPO_ROOT is ~/.mc — fall back to the daemon's own
// home checkout, else the token is only ever found when running the in-repo copy.
const TOKEN_FILES = [path.join(REPO_ROOT, ".admin-token"), path.join(os.homedir(), "chronos", ".admin-token")];
function adminToken() {
  // CHRONOS_ADMIN is what the executives' processes carry (see WarmManager extraEnv); the _TOKEN name
  // is what a human shell exports. Accept both, or an admin-gated command works for the operator and mystery-
  // fails for Robert.
  if (process.env.CHRONOS_ADMIN_TOKEN) return process.env.CHRONOS_ADMIN_TOKEN;
  if (process.env.CHRONOS_ADMIN) return process.env.CHRONOS_ADMIN;
  for (const f of TOKEN_FILES) {
    try { const t = fs.readFileSync(f, "utf8").trim(); if (t) return t; } catch {}
  }
  return null;
}
function adminHeaders() {
  const token = adminToken();
  if (!token) die(`admin token not readable at ${TOKEN_FILES.join(" or ")} — this action is admin-gated; run on the daemon machine.`);
  return { "x-mc-admin": token };
}
// `session send`/`key` are admin-gated OR a live Lead's own credential (LEADS.md: x-mc-lead). A
// Lead's env carries MC_LEAD_TOKEN, not the admin token — so it needs its own header, tried first
// only when no admin token is readable (the daemon host itself may be a Lead's operator too).
function handHeaders() {
  const token = adminToken();
  if (token) return { "x-mc-admin": token };
  if (process.env.MC_LEAD_TOKEN) return { "x-mc-lead": process.env.MC_LEAD_TOKEN };
  die(`neither an admin token (${TOKEN_FILES.join(" or ")}) nor MC_LEAD_TOKEN is set — typing into a terminal needs one or the other.`);
}

const HELP = `mc — Mission Control backlog CLI
  mc ticket new --title "..." [--priority P1|P2|P3] [--body "..."] [--status backlog] [--parent GOAL-KEY]
                [--workspace ID] [--repo ID] [--backend claude-code|cursor-agent|cursor-cloud] [--model m]
                (--parent GOAL-KEY files this ticket as a child of a goal → the goal's agents inherit context)
  mc ticket list [--workspace ID] [--status s]
  mc ticket get <KEY>
  mc goal <KEY>              goal completion: % done + child tickets (a goal = any ticket with children).
                            Group work under a goal via --parent on 'ticket new' or 'mc ticket link GOAL parent CHILD'.
                            Goals are umbrellas: they are never planned/built by an agent, only tracked.
  mc ticket update <KEY> [--status s] [--priority p] [--title t] [--difficulty 1-5] [--pr-state open|merged|closed]
  mc ticket rm <KEY>         delete a ticket
  mc ticket links [<KEY>]                       list a ticket's relationships (defaults to MC_TICKET)
  mc ticket link <FROM> <type> <TO>             add a relationship (type: blocks|parent|relates|duplicates)
                                                e.g. 'mc ticket link ACM-10 blocks ACM-12' → ACM-12 can't build until ACM-10 is done
  mc ticket unlink <FROM> <type> <TO>           remove a relationship
  mc verdict <reviewId> approve|changes ["notes"] [--lens NAME]   deliver a QA verdict (--lens when on a review panel)
  mc review <KEY> [--report "<md>" | --report -]   move to review; --report attaches the build handoff (feeds the review card + PR body). "-" reads markdown from stdin.
  mc done [<KEY>]            mark done (defaults to MC_TICKET)
  mc dismiss [<KEY>] ["why"] decided against it — closes the ticket without deleting it (keeps the reason)
  mc note [<KEY>] "text"     append a note to the ticket's work log (local only)
  mc comment [<KEY>] "text"  post a comment to the ticket's linked Jira/ClickUp issue (explicit push)
  mc push-status [<KEY>] [--hours N]   push the ticket's current status out to Jira/ClickUp (explicit push)
  mc hours <N> [<KEY>]       write Hours Spent on the linked Jira issue (status untouched) + log it locally
  mc pdf <file>              print a PDF's text layer — ~5-10x cheaper than vision-reading pages.
                             Empty output = scanned PDF: Read the PDF itself (vision) instead.
  mc remember "<short rule>" [--topic T] [--detail "longer why/how"] [--workspace ID]
                             put a rule EVERY future agent here must know into the memory tree: the line
                             (≤200 chars) goes under ## T in the ★ memory-index (always in the prompt);
                             --detail goes to the memory-<t> branch memo, read on demand. Refused when
                             either would pass its cap — condense first. Use for "remember / always / from now on".
  mc learn "<durable fact>" [--label L] [--workspace ID]   note a fact in the session-learnings inbox (NOT auto-loaded; the operator promotes it)
  mc lesson list [--state active|proposed] [--topic build|review|comms] [--repo ID]
                             rules this workspace has learned; ● active (injected into agents), ○ proposed
  mc lesson add "<rule>" [--scope "src/api/**"] [--topic build|review|comms] [--repo ID]
                             record a durable rule — one imperative sentence a FUTURE agent needs
  mc lesson promote|archive|rm <id>
  mc plan [<KEY>] "<md>" [--difficulty 1-5]   save a plan → ticket 'planned' (provisional grade; drives build-agent routing)
  mc grade [<KEY>] <1-5> "<review note>"       second-pass difficulty grade (1=one-liner … 5=architectural) → build-agent routing
  mc memo list                       workspace notes vault (🌐=global, ★=auto-loads into agents, 📌=pinned)
  mc memo get <name|slug>
  mc memo context                    print the notes that auto-seed every agent here
  mc memo new --title "..." [--body "..."] [--pin] [--context] [--repos a,b] [--global] [--workspace ID]
  mc memo edit <name> [--body "..."] [--title t] [--pin true|false] [--context true|false] [--repos a,b|none] [--global]
  mc memo append <name> "text" [--heading "..."]
  mc memo rm <name>
  mc worklog [<workspace>] [--limit N]   what has been FINISHED here, newest first, with what each piece left pending
  mc worklog add "<what>" --outcome "..." [--pending "a;b"] [--next "c;d"] [--pr URL] [--ticket KEY] [<workspace>]
                             record work the daemon did not see (a call, a decision, work done outside a terminal)
  mc worklog backfill <workspace> [--since 7d] [--limit N]   summarize already-ended terminals/runs into the ledger (costs model calls; idempotent)
  mc jot list [--date YYYY-MM-DD] [--workspace ID]   the Desk's parked cards (▶ Run opens a terminal from one); --date = one day's plan
  mc jot new --date YYYY-MM-DD --title "..." [--body "..." | --body -]   file a card for a day (a "plan tomorrow" terminal's one write)
  (notes flagged --context auto-load into every agent's system prompt in this workspace)
  (--repos a,b scopes a ★ context memo to specific repos [names or ids]: it loads ONLY for agents in those repos; omit = workspace-wide. --repos none clears the scope.)
  (--global = operator profile: crosses ALL workspaces; admin-gated, run on the daemon host. Pair with --context to inject.)
  mc job list [--workspace ID]
  mc job get <ID|name>
  mc job run <ID|name>       dispatch a job now (headless)
  mc job rm <ID|name>        delete a job
  mc job new --name "..." --goal "..." [--cron "0 9 * * 1-5" | --at "2026-09-12 09:00"] [--backend b] [--model m]
             [--workspace ID] [--cwd path] [--sandbox guard|strict|off]
             [--allowed-tools "..."] [--disallowed-tools "..."]
             (--cwd defaults to the current dir, else $HOME with a note; an explicit --cwd outside the workspace's repos/landing dir is refused)
  mc job update <ID|name> [--cwd path] [--sandbox guard|strict|off] [--model m] [--backend b] [--name "..."] [--goal "..."]
             [--cron "..." | --at "..." | --manual] [--tz Area/City] [--allowed-tools "..."] [--disallowed-tools "..."]
             [--timeout-sec N] [--budget USD] [--notify all|failures|off] [--enabled true|false]
  mc skill list [--status active|pending|archived] [--workspace ID]   reusable procedures in this ws
  mc skill view <slug> [refFile]     full SKILL.md (or a reference file); counts as a use
  mc skill new --name "short-name" --description "when X, do Y" [--category c] [--tags a,b]
               [--body "..."]        (or pipe the markdown body via stdin/heredoc)
  mc skill patch <slug> --old "exact text" --new "replacement"        improve a skill in place
  mc skill append <slug> "text" [--heading "..."]                     add to a skill
