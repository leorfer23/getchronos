# Copy to .secrets (gitignored) and fill in what you need. Loaded into process.env at boot by
# src/env.ts, read relative to the daemon's working directory — i.e. this repo root.
#
# NOTHING HERE IS REQUIRED. The daemon boots with this file absent. Everything below either has a
# working default or turns a feature on. CONFIGURATION.md documents all ~150 variables; this file
# is the subset worth thinking about on a new machine.
#
# This is also where everything machine-specific goes: paths, tokens, accounts. It is never
# committed, so two machines can run the same checkout with different layouts and neither one's
# config breaks when the other opens a PR.

# --- Spend ceilings (read this one) ---------------------------------------------------------
# Both default to UNLIMITED. Chronos spawns agent CLIs that cost money and can loop.
# CHRONOS_DAILY_BUDGET=20            # USD/day across every project. 0 = no cap.
# CHRONOS_MAX_CONCURRENT=3           # simultaneous headless runs. 0 = no cap.
#
# The burn guard is separate and caps the RATE, not the total — a runaway can spend a day's budget
# in four minutes, and this is what stops it. Defaults shown; raise them only deliberately.
# CHRONOS_BURN_ALERT_RUNS=60
# CHRONOS_BURN_HALT_RUNS=100
# CHRONOS_BURN_ALERT_USD=40
# CHRONOS_BURN_HALT_USD=60

# --- Sandbox: where this machine keeps its project checkouts -------------------------------
# Colon-separated. Denied to guard/strict jobs, EXCEPT a job's own cwd/add_dirs — so a job
# scoped into one of these still works while jobs elsewhere cannot read sibling projects.
# There is no portable default: leave it unset and the daemon warns at boot that guard-mode
# jobs have no sibling-project isolation.
#   Example (checkouts under ~/code):
# CHRONOS_PROTECTED_DIRS_EXTRA=/Users/you/code

# Extra absolute-deny paths (read+write), appended to the built-in baseline of ~/.ssh, ~/.aws,
# ~/.config/gcloud, ~/.config/gws, ~/.kube, the admin token, the database, the CA private keys
# and browser profiles. Put this machine's project-level secret files here.
#   Example:
# CHRONOS_PROTECTED_SECRETS_EXTRA=/Users/you/code/api/.env:/Users/you/code/api/.dev.vars

# Default sandbox mode for new jobs: off | guard | strict. macOS only — on any other platform
# every job runs unsandboxed regardless of what this says.
# CHRONOS_SANDBOX_DEFAULT=guard

# --- Profiles (which account a job is billed to) -------------------------------------------
# A profile is a CLI config directory with its own login, settings, skills and MCP servers.
# ~/.claude is always available as "claude"; every ~/.claude-<name> directory is discovered and
# offered as "claude-<name>". Pin one per project (workspaces.config_dir) and one client's work
# can never be billed to another client's account.
# CHRONOS_DEFAULT_PROFILE=claude
# For directories that don't follow the ~/.claude-<name> convention — name=/abs/path, colon-separated:
# CHRONOS_PROFILES=work=/opt/shared/.claude-work

# --- Egress broker CA (src/egress-ca.ts) ---------------------------------------------------
# Where the local CA that signs intercepted TLS connections lives. Created on demand, 0700, and
# its two private keys are absolute-denied to sandboxed jobs. It is NEVER installed in the system
# keychain: only the daemon's own children are pointed at it (NODE_EXTRA_CA_CERTS + a bundle).
# Move it and the deny list follows — but keep it off any path an agent's cwd could cover.
# CHRONOS_EGRESS_CA_DIR=/Users/you/chronos/ca
# The system root store the trust bundle is built on top of. Only override if this machine keeps
# its OpenSSL roots somewhere else; if the file is unreadable Chronos falls back to appending the
# CA to node's built-in roots instead of replacing any tool's trust store.
# CHRONOS_EGRESS_SYSTEM_ROOTS=/etc/ssl/cert.pem

# --- Telegram bot -------------------------------------------------------------------------
# Token from @BotFather (/newbot). Without it the bot stays disabled and says so at boot.
# CHRONOS_TG_TOKEN=
# Locks control + notifications to one chat. Send /start to the bot and it replies with the id.
# CHRONOS_TG_CHAT_ID=

# --- Cloudflare relay (remote webhook triggers, no inbound port) ---------------------------
# See relay/. The daemon dials OUT to the worker, so nothing is exposed on your network.
# CHRONOS_RELAY_URL=wss://your-relay.workers.dev/ws
# CHRONOS_RELAY_TOKEN=

# --- Alternate agent backends --------------------------------------------------------------
# Chronos drives each CLI's own binary, so you bring your own auth for each. Only needed if a
# project routes to them; see README → Backends.
# CHRONOS_CLAUDE_BIN=claude
# CHRONOS_CODEX_BIN=codex
# CHRONOS_CURSOR_BIN=cursor-agent
# CHRONOS_GROK_BIN=/Users/you/.grok/bin/grok
# CHRONOS_OPENCODE_BIN=opencode

# --- Autonomy: three of these are ON by default --------------------------------------------
# Set them to 0 before pointing Chronos at a repo you care about, if you would rather decide first.
# CHRONOS_AUTO_MERGE=0               # the merge gate lands an approved PR by itself
# CHRONOS_AUTO_CI_FIX=0              # a red PR gets an agent dispatched at it
# CHRONOS_SELF_DEPLOY=0              # THIS checkout rebuilds + restarts the daemon when main moves

# --- Going quiet ----------------------------------------------------------------------------
# Every proactive message can be turned off without stopping the daemon.
# CHRONOS_DAY_HEARTBEAT=0            # periodic fleet check-in
# CHRONOS_STANDUP=0                  # daily standup (already inert unless _WORKSPACES is set)
# CHRONOS_STANDUP_WORKSPACES=acme,globex
# CHRONOS_AUTOPLAN_MIN=0             # read-only planners sweeping the backlog
# CHRONOS_ASK_REMIND_HOURS=0         # re-surfacing unanswered questions
# CHRONOS_DIGEST_HOUR=-1             # NOTE: also disables the nightly DB backup (hourly continue)

# --- Overrides you may want per machine ----------------------------------------------------
# CHRONOS_PORT=7777
# CHRONOS_HOME=/Users/you/chronos    # moves ALL state (db, notes, tickets, backups) in one go
# CHRONOS_DB=/Users/you/chronos/chronos.db
# CHRONOS_CAL_IGNORE_TITLES=standup,lunch    # calendar noise, hidden from agenda + reminders
