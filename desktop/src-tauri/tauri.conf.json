{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mission Control",
  "version": "0.1.0",
  "identifier": "site.chronos.missioncontrol",
  "build": {
    "frontendDist": "../dist-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mission Control",
        "url": "http://localhost:7777/?mc_shell=tauri",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 14 },
        "backgroundColor": "#0a0c10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/128x128@2x.png", "icons/128x128.png", "icons/32x32.png"],
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}
